# Required public browser configuration. Use the Supabase project URL and
# publishable/legacy anon key. Never use a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended canonical production URL, without a trailing slash. If omitted on
# Vercel, the app uses Vercel's automatically provided production/deployment URL.
NEXT_PUBLIC_SITE_URL=

# Optional full MapLibre satellite style URL. Takes priority over all other map settings.
NEXT_PUBLIC_SATELLITE_STYLE_URL=
# Optional XYZ satellite tile template and provider attribution. Leave blank to use
# the built-in Esri World Imagery development basemap with visible attribution.
NEXT_PUBLIC_SATELLITE_TILE_URL=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
# Backwards-compatible generic MapLibre style override.
NEXT_PUBLIC_MAP_STYLE_URL=
